# =============================================================================
# AuraSaaS — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o arquivo .env no repositório!
#
# Para carregar automaticamente, instale python-dotenv:
#   pip install python-dotenv
# E adicione no settings.py (no topo):
#   from dotenv import load_dotenv
#   load_dotenv()
# =============================================================================

# --- Django Core ---
# Gere uma nova chave com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=sua-chave-secreta-aqui

# Em desenvolvimento: True | Em produção: False
DEBUG=True

# Em produção: seudominio.com,www.seudominio.com
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Banco de Dados ---
# Formato: postgresql://usuario:senha@host:porta/nome_banco?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# --- E-mail (SMTP) ---
# Em desenvolvimento, deixe o backend de console (imprime no terminal):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Em produção, use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
# App Password do Gmail (não a senha normal): https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=seu-email@gmail.com
